AGENT_DATA_DIR=./data
AGENT_BRAND_NAME=知行工作台
AGENT_MODEL=deepseek-v4.1-flash-1017
AGENT_EFFORT=medium
# Private model catalog: copy model-catalog.example.json, fill authorized routes,
# and keep the resulting file on the execution server, outside public assets.
AGENT_MODEL_CATALOG=/path/to/private/model-catalog.json
# Optional override of the catalog default. Public IDs only.
# AGENT_DEFAULT_MODEL_ID=dano-v2.1
# Keep AGENT_MODEL/AGENT_EFFORT at their previous values during upgrade so
# historical conversations retain their actual model and reasoning settings.
# Verified Tencent provider. External env overrides the provider settings file.
ANTHROPIC_BASE_URL=https://tokenhub.tencentmaas.com
# Absolute path to an authorized settings file; imports allowlisted provider env and model ONLY.
AGENT_PROVIDER_SETTINGS=/path/to/authorized/provider-settings.json
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
AGENT_COOKIE_SECURE=false
AGENT_IDLE_SECONDS=600
AGENT_APPROVAL_SECONDS=600
AGENT_MAX_ACTIVE_SESSIONS=4
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=5
AGENT_PROVIDER_COST_RELIABLE=false
# Prepare model files with scripts/prepare_knowledge_models.py before enabling.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AGENT_KNOWLEDGE_MODEL_CACHE=/private/agent-models
AGENT_KNOWLEDGE_ALLOW_MODEL_DOWNLOAD=false
# Optional external key; otherwise generated in AGENT_DATA_DIR/encryption.key.
# AGENT_SECRET_KEY_FILE=/private/encryption.key
