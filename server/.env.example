AGENT_DATA_DIR=./data
AGENT_BRAND_NAME=知行工作台
AGENT_MODEL=deepseek-v4.1-flash-1017
# New-deployment default only; preserve an existing deployment's explicit effort.
AGENT_EFFORT=high
# Deployment-level capability boundary. Keep normal for the existing product;
# trial enables only the server-side allowlist and rejects unknown routes,
# tools, request fields and retrieval modes.
AGENT_DEPLOYMENT_MODE=normal
# The low-code workflow surface is retired from the product. Keep this false
# for customer or preview deployments; legacy API contracts return 410 while
# their tables remain available for an explicit migration.
AGENT_WORKFLOWS_ENABLED=false
# Optional comma-separated subset of known trial capabilities. Unset uses the
# reviewed default set. Unknown or misspelled names abort startup.
# AGENT_TRIAL_CAPABILITIES=health,auth,config,models.read,assistants.read,conversations.read,conversations.write,messages.read,messages.send,runs.read,runs.cancel,knowledge.read,knowledge.search,sources.read,agent.knowledge_tools
# Private model catalog: copy model-catalog.example.json, fill authorized routes,
# and keep the resulting file on the execution server, outside public assets.
AGENT_MODEL_CATALOG=/path/to/private/model-catalog.json
# Optional override of the catalog default. Public IDs only.
# AGENT_DEFAULT_MODEL_ID=dano-v2.1
# Optional exact public catalog id for fitness routing and model Tab
# completion. Leave unset unless that route is configured and authorized.
# AGENT_MODEL_ROUTER_MODEL_ID=deepseek-v4.1-flash-1007
# Tab completion is an independent low-risk route.
# AGENT_TAB_COMPLETION_MODEL_ID=deepseek-v4.1-flash-1017
# Tab has an independent low-risk admission switch and does not require
# enabling the Fitness router. Provider and exact-target checks still fail
# closed before any request is sent.
# AGENT_TAB_COMPLETION_ENABLED=true
# Knowledge roles must point to enabled catalog entries declaring the
# corresponding capability; no generic chat-model fallback is allowed.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL_ID=
# AGENT_KNOWLEDGE_VISION_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_ENTITY_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_RELATION_MODEL_ID=deepseek-v4-flash-202605
# TokenHub OpenAI Chat Completions visual route. A loopback URL is allowed only
# for a controlled development bridge whose upstream is still TokenHub.
# AGENT_KNOWLEDGE_VISION_BASE_URL=https://tokenhub.tencentmaas.com/v1
# AGENT_KNOWLEDGE_VISION_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_VISION_ENABLED=false
# Keep AGENT_MODEL/AGENT_EFFORT at their previous values during upgrade so
# historical conversations retain their actual model and reasoning settings.
# Verified Tencent provider. External env overrides the provider settings file.
ANTHROPIC_BASE_URL=https://tokenhub.tencentmaas.com
# Harness requires an authorized Anthropic Messages API Key, not a legacy
# Claude Bearer token. Configure it privately; never place it in client code.
# ANTHROPIC_API_KEY=
# Absolute path to an authorized settings file; imports allowlisted provider env and model ONLY.
AGENT_PROVIDER_SETTINGS=/path/to/authorized/provider-settings.json
# Test-only switch for reserved local/synthetic gateways. Keep false or unset
# in any customer or release deployment; production requires TokenHub.
# AGENT_PROVIDER_TEST_MODE=false
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
AGENT_COOKIE_SECURE=false
AGENT_IDLE_SECONDS=600
AGENT_APPROVAL_SECONDS=600
AGENT_MAX_ACTIVE_SESSIONS=4
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=5
AGENT_PROVIDER_COST_RELIABLE=false
# Prepare model files with scripts/prepare_knowledge_models.py before enabling.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AGENT_KNOWLEDGE_MODEL_CACHE=/private/agent-models
AGENT_KNOWLEDGE_ALLOW_MODEL_DOWNLOAD=false

# Web search defaults to public Bing RSS. Optional SearXNG/Brave providers are
# explicit and fail closed when their endpoint or credential is absent.
# AGENT_WEB_SEARCH_PROVIDER=bing_rss
# AGENT_WEB_SEARCH_SEARXNG_URL=https://search.example.com/search
# AGENT_WEB_SEARCH_BRAVE_URL=https://api.search.brave.com/res/v1/web/search
# AGENT_WEB_SEARCH_BRAVE_API_KEY=
# AGENT_WEB_SEARCH_FALLBACK_BING=true

# Optional official application-tools route (Search/Fetch and OCR). Disabled
# by default; this separate key does not alter the TokenHub model route.
# AGENT_DEEPSEEK_API_ENABLED=false
# AGENT_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# AGENT_DEEPSEEK_API_KEY=
# AGENT_DEEPSEEK_API_TIMEOUT_SECONDS=30
# AGENT_DEEPSEEK_API_OCR_ENABLED=false

# Optional Feishu bridge gateway. The bridge itself runs as a separate
# process. Bind this API to loopback and put the random token in a 0600 file
# in production.
# AGENT_FEISHU_BRIDGE_TOKEN_FILE=/private/zhixing-feishu-bridge.token
# AGENT_FEISHU_USER_ID=workbench-user-id
# AGENT_FEISHU_USERNAME=workbench-username
# AGENT_FEISHU_ASSISTANT_ID=assistant-id
# AGENT_FEISHU_ALLOWED_OPEN_IDS=ou_xxx
# AGENT_FEISHU_ALLOWED_CHAT_IDS=oc_xxx
# AGENT_FEISHU_ALLOW_GROUP_CHATS=false
# H5 web application login. This is a separate Feishu app from the bot bridge.
# The browser only receives FEISHU_H5_APP_ID; its secret is used here to
# exchange the one-time requestAccess code and is never returned to the
# client. Set an explicit allowlist before enabling it.
# AGENT_FEISHU_H5_ENABLED=true
# FEISHU_H5_APP_ID=cli_xxx
# FEISHU_H5_APP_SECRET=
# AGENT_FEISHU_H5_ALLOWED_OPEN_IDS=ou_xxx,ou_yyy
# AGENT_FEISHU_H5_USER_MAP={"ou_xxx":"alice"}
# FEISHU_API_BASE_URL=https://open.feishu.cn
# Optional signed loopback facade for a separately managed steward. Keep this
# secret out of browser assets and use only on a loopback-bound API process.
# AGENT_FEISHU_INTERNAL_SECRET=
# AGENT_FEISHU_INTERNAL_CLOCK_SKEW_SECONDS=60
# AGENT_FEISHU_OWNER_USER_ID=workbench-user-id
# Optional external key; otherwise generated in AGENT_DATA_DIR/encryption.key.
# AGENT_SECRET_KEY_FILE=/private/encryption.key

# Harness is the default for new conversations; old executor IDs never migrate.
# Explicit claude rolls back new conversations only. Configure reviewed paths
# and a supported model/reasoning level; missing configuration fails explicitly,
# without scanning installations or falling back to Claude. See
# docs/operations/HARNESS_PILOT.md; changing this file restarts no service.
AGENT_RUNTIME_TYPE=harness
# AGENT_HARNESS_NODE_PATH=/absolute/path/.runtime/harness-toolchain/node-v24.9.0-linux-x64/bin/node
# AGENT_HARNESS_SOURCE_DIR=/absolute/path/.runtime/third_party/deepseek-harness
# Per model response, not a goal budget or a monetary spending cap.
# AGENT_HARNESS_MAX_OUTPUT_TOKENS=8192
# One owned manual-compaction run, including its summary model request.
# AGENT_HARNESS_COMPACTION_TIMEOUT_SECONDS=600

# User-text admission. Configure policy in Workspace Administration or seed it from JSON.
# The qwen mode uses Qwen3Guard-Gen-0.6B on the same host/network namespace.
AGENT_PROMPT_SAFETY_MODE=off
# AGENT_PROMPT_SAFETY_POLICY=/etc/kaiwu/prompt-safety.json
# AGENT_PROMPT_SAFETY_QWEN_URL=http://127.0.0.1:8091/v1
# AGENT_PROMPT_SAFETY_QWEN_MODEL=Qwen/Qwen3Guard-Gen-0.6B
# AGENT_PROMPT_SAFETY_TIMEOUT_SECONDS=10
