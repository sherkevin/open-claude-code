# Copy to .env; never commit real credentials.
ANTHROPIC_BASE_URL=https://tokenhub.tencentmaas.com
# Harness requires an authorized Anthropic Messages API Key; configure it
# privately. A legacy Claude Bearer token is not an interchangeable API Key.
# ANTHROPIC_API_KEY=
# Set an authorized legacy Claude token only for that explicit runtime.
# Never put either credential in client code.
ANTHROPIC_AUTH_TOKEN=
# Test-only switch for reserved local/synthetic gateways. Keep false or unset
# in any customer or release deployment; production requires TokenHub.
# AGENT_PROVIDER_TEST_MODE=false
# Compose host path only: create this private JSON from server/model-catalog.example.json
# and configure authorized routes before starting. Compose mounts it read-only and
# sets AGENT_MODEL_CATALOG=/run/agent-config/model-catalog.json inside the container.
# Native processes instead set AGENT_MODEL_CATALOG to their own absolute host path;
# do not export the container path into a native service.
AGENT_MODEL_CATALOG_HOST=./.runtime/config/model-catalog.json
# Optional public default; select an enabled catalog item only.
# AGENT_DEFAULT_MODEL_ID=deepseek-v4.1-flash
# Optional exact public catalog id for fitness routing and model Tab
# completion; keep unset until the route is explicitly authorized.
# AGENT_MODEL_ROUTER_MODEL_ID=deepseek-v4.1-flash-1007
# Tab completion is independent from Fitness and defaults to the requested
# public 1017 route. Keep its private upstream mapping in the catalog.
# AGENT_TAB_COMPLETION_MODEL_ID=deepseek-v4.1-flash-1017
# Tab is independently gated from Fitness routing; it still requires an
# authorized target, provider credentials and a positive bounded budget.
# AGENT_TAB_COMPLETION_ENABLED=true
# Knowledge roles use explicit catalog capabilities; no generic chat-model
# fallback is allowed for visual, embedding, entity or relation processing.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL_ID=
# AGENT_KNOWLEDGE_VISION_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_ENTITY_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_RELATION_MODEL_ID=deepseek-v4-flash-202605
# TokenHub OpenAI-compatible visual route. A loopback URL is allowed only for
# a controlled development bridge whose upstream is still TokenHub.
# AGENT_KNOWLEDGE_VISION_BASE_URL=https://tokenhub.tencentmaas.com/v1
# AGENT_KNOWLEDGE_VISION_MODEL_ID=deepseek-v4-flash-202605
# AGENT_KNOWLEDGE_VISION_ENABLED=false
CLIENT_BIND=127.0.0.1
CLIENT_PORT=8080
AGENT_BRAND_NAME=知行工作台
AGENT_MODEL=deepseek-v4.1-flash-1017
# New-deployment default only; preserve an existing deployment's explicit effort.
AGENT_EFFORT=high
# Deployment-level capability boundary. Keep normal for the existing product;
# trial is an explicit server-side allowlist and fails closed for unknown routes,
# tools, request fields and retrieval modes.
AGENT_DEPLOYMENT_MODE=normal
# The low-code workflow surface is retired from the product. Keep this false
# for customer or preview deployments; legacy API contracts return 410 while
# their tables remain available for an explicit migration.
AGENT_WORKFLOWS_ENABLED=false
# Optional comma-separated subset of known trial capabilities. Unset uses the
# reviewed default set. Unknown or misspelled names abort startup.
# AGENT_TRIAL_CAPABILITIES=health,auth,config,models.read,assistants.read,conversations.read,conversations.write,messages.read,messages.send,runs.read,runs.cancel,knowledge.read,knowledge.search,sources.read,agent.knowledge_tools
AGENT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AGENT_COOKIE_SECURE=false
# Optional Feishu H5 web application. Create a separate enterprise self-built
# app from the bot bridge app, enable Web App, and keep its secret on the
# server only. FEISHU_APP_ID/SECRET remain reserved for the bot bridge.
# AGENT_FEISHU_H5_ENABLED=true
# FEISHU_H5_APP_ID=cli_xxx
# FEISHU_H5_APP_SECRET=
# AGENT_FEISHU_H5_ALLOWED_OPEN_IDS=ou_xxx,ou_yyy
# Map each Feishu open_id to an existing local username or user id. For a
# single-user deployment AGENT_FEISHU_USERNAME/USER_ID may be reused instead.
# AGENT_FEISHU_H5_USER_MAP={"ou_xxx":"alice"}
# FEISHU_API_BASE_URL=https://open.feishu.cn
# Use true behind an HTTPS reverse proxy, and set its exact public origin above.
AGENT_MCP_ALLOWED_HOSTS=your-mcp-host.example.com
AGENT_IDLE_SECONDS=600
AGENT_APPROVAL_SECONDS=600
AGENT_MAX_ACTIVE_SESSIONS=4
AGENT_MAX_TURNS=30
# New conversations default to Harness; existing conversations retain their
# stored executor. Explicit claude is a rollback for new conversations only.
# Configure the reviewed paths and a supported model/reasoning level first;
# missing Harness configuration fails explicitly, never falls back to Claude.
# See docs/operations/HARNESS_PILOT.md. This does not restart existing services.
AGENT_RUNTIME_TYPE=harness
# AGENT_HARNESS_NODE_PATH=/absolute/path/.runtime/harness-toolchain/node-v24.9.0-linux-x64/bin/node
# AGENT_HARNESS_SOURCE_DIR=/absolute/path/.runtime/third_party/deepseek-harness
# Per model response, not a goal budget or a monetary spending cap.
# AGENT_HARNESS_MAX_OUTPUT_TOKENS=8192
# One owned manual-compaction run, including its summary model request.
# AGENT_HARNESS_COMPACTION_TIMEOUT_SECONDS=600
AGENT_MAX_BUDGET_USD=5
# Third-party provider SDK cost estimates are not a bill or a hard spend cap.
AGENT_PROVIDER_COST_RELIABLE=false
# Optional local semantic retrieval; prepare the cache before enabling.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AGENT_KNOWLEDGE_MODEL_CACHE=/data/knowledge/models
AGENT_KNOWLEDGE_ALLOW_MODEL_DOWNLOAD=false
# Web search uses public Bing RSS by default. Optional SearXNG or Brave routes
# are explicit and fail closed when their endpoint/credential is absent. Do
# not put enterprise documents, user credentials or provider keys in queries.
# AGENT_WEB_SEARCH_PROVIDER=bing_rss
# AGENT_WEB_SEARCH_SEARXNG_URL=https://search.example.com/search
# AGENT_WEB_SEARCH_BRAVE_URL=https://api.search.brave.com/res/v1/web/search
# AGENT_WEB_SEARCH_BRAVE_API_KEY=
# AGENT_WEB_SEARCH_FALLBACK_BING=true

# Kaiwu enterprise MCP bridge. Keep the control-plane credential out of Git.
# The public Edge path must exactly match the mounted FastAPI path.
# AGENT_KAIWU_CONTROL_ENABLED=true
# AGENT_KAIWU_CONTROL_ADMIN_TOKEN_FILE=/etc/kaiwu-bridge/admin-token
# AGENT_KAIWU_CONTROL_RELAY_ADDRESS=relay.example.com
# AGENT_KAIWU_CONTROL_RELAY_PORT=443
# AGENT_KAIWU_CONTROL_RELAY_PROTOCOL=wss
# AGENT_KAIWU_CONTROL_RELAY_TLS_ENABLED=true
# AGENT_KAIWU_CONTROL_RELAY_TLS_SERVER_NAME=relay.example.com
# AGENT_KAIWU_CONTROL_RELAY_BIND_ADDRESS=127.0.0.1
# AGENT_KAIWU_CONTROL_RELAY_BIND_PORT=37443
# AGENT_KAIWU_CONTROL_EDGE_USER=kaiwu-edge
# AGENT_KAIWU_EDGE_PUBLIC_BASE=https://flintw.com/projects/kaiwu/mcp
# AGENT_KAIWU_EDGE_MOUNT_PATH=/projects/kaiwu/mcp
# AGENT_KAIWU_EDGE_VISITOR_HOST=127.0.0.1
# AGENT_KAIWU_EDGE_VISITOR_PORT_START=31000
# AGENT_KAIWU_EDGE_VISITOR_PORT_END=31999

# Optional official application-tools route (Search/Fetch and OCR). Disabled
# by default; this separate key does not alter the TokenHub model route.
# AGENT_DEEPSEEK_API_ENABLED=false
# AGENT_DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# AGENT_DEEPSEEK_API_KEY=
# AGENT_DEEPSEEK_API_TIMEOUT_SECONDS=30
# AGENT_DEEPSEEK_API_OCR_ENABLED=false
