# Copy to .env; never commit real credentials.
ANTHROPIC_BASE_URL=https://tokenhub.tencentmaas.com
# Set an authorized provider token in your private .env. Never put it in client code.
ANTHROPIC_AUTH_TOKEN=
# Compose host path only: create this private JSON from server/model-catalog.example.json
# and configure authorized routes before starting. Compose mounts it read-only and
# sets AGENT_MODEL_CATALOG=/run/agent-config/model-catalog.json inside the container.
# Native processes instead set AGENT_MODEL_CATALOG to their own absolute host path;
# do not export the container path into a native service.
AGENT_MODEL_CATALOG_HOST=./.runtime/config/model-catalog.json
# Optional public default; select an enabled catalog item only.
# AGENT_DEFAULT_MODEL_ID=deepseek-v4.1-flash
CLIENT_BIND=127.0.0.1
CLIENT_PORT=8080
AGENT_BRAND_NAME=知行工作台
AGENT_MODEL=deepseek-v4.1-flash-1017
AGENT_EFFORT=medium
AGENT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AGENT_COOKIE_SECURE=false
# Use true behind an HTTPS reverse proxy, and set its exact public origin above.
AGENT_MCP_ALLOWED_HOSTS=your-mcp-host.example.com
AGENT_IDLE_SECONDS=600
AGENT_APPROVAL_SECONDS=600
AGENT_MAX_ACTIVE_SESSIONS=4
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=5
# Third-party provider SDK cost estimates are not a bill or a hard spend cap.
AGENT_PROVIDER_COST_RELIABLE=false
# Optional local semantic retrieval; prepare the cache before enabling.
# AGENT_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AGENT_KNOWLEDGE_MODEL_CACHE=/data/knowledge/models
AGENT_KNOWLEDGE_ALLOW_MODEL_DOWNLOAD=false

